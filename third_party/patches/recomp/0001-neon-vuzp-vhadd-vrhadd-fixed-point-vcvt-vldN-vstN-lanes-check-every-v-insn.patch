+// fixed point with fraction bits (scale = 2^fbits): to fixed rounds towards zero and saturates
+// (NaN -> 0, denormal inputs flushed), from fixed rounds once (the division by 2^fbits is exact)
+struct FToS32Fix {
+    double scale;
+    int32_t operator()(float a, bool &) const {
+        a = nf_in(a);
+        if (a != a)
+            return 0;
+        const double x = double(a) * scale;
+        if (x >= 2147483648.0)
+            return std::numeric_limits<int32_t>::max();
+        if (x <= -2147483648.0)
+            return std::numeric_limits<int32_t>::min();
+        return static_cast<int32_t>(x);
+    }
+};
+struct FToU32Fix {
+    double scale;
+    uint32_t operator()(float a, bool &) const {
+        a = nf_in(a);
+        const double x = double(a) * scale;
+        if (a != a || x <= 0.0)
+            return 0;
+        if (x >= 4294967296.0)
+            return std::numeric_limits<uint32_t>::max();
+        return static_cast<uint32_t>(x);
+    }
+};
+struct S32FixToF { double scale; float operator()(int32_t a, bool &) const { return static_cast<float>(double(a) / scale); } };
