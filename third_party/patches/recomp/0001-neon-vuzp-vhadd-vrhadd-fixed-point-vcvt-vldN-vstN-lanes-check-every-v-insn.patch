+// vuzp: de-interleave the 2N elements of d:m; the even ones go to d, the odd ones to m
+template <typename T, int N>
+inline void vuzp(GuestContext *c, unsigned d, unsigned m) {
+    const auto a = vget<T, N>(c, d);
+    const auto b = vget<T, N>(c, m);
+    T z[2 * N];
+    for (int i = 0; i < N; i++) {
+        z[i] = a.e[i];
+        z[N + i] = b.e[i];
+    }
+    Vec<T, N> even, odd;
+    for (int i = 0; i < N; i++) {
+        even.e[i] = z[2 * i];
+        odd.e[i] = z[2 * i + 1];
+    }
+    vset(c, d, even);
+    vset(c, m, odd);
+}
+
