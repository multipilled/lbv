     user32.PostMessageW(hwnd, WM_KEYUP if not down else WM_KEYDOWN, vk, lparam)
 
 
+WM_MOUSEMOVE, WM_LBUTTONDOWN, WM_LBUTTONUP, WM_RBUTTONDOWN, WM_RBUTTONUP = 0x200, 0x201, 0x202, 0x204, 0x205
+
+
+def mouse(hwnd, button, x, y, ms):
+    """Holds the left or right mouse button at (x, y) of the 960x544 screen for ms (posted messages)."""
+    rc = wintypes.RECT()
+    user32.GetClientRect(hwnd, ctypes.byref(rc))
+    px, py = int(x * rc.right / 960), int(y * rc.bottom / 544)
+    pos = (py << 16) | (px & 0xFFFF)
+    down, up, flag = (WM_LBUTTONDOWN, WM_LBUTTONUP, 1) if button == "l" else (WM_RBUTTONDOWN, WM_RBUTTONUP, 2)
+    user32.PostMessageW(hwnd, WM_MOUSEMOVE, 0, pos)
+    user32.PostMessageW(hwnd, down, flag, pos)
+    time.sleep(ms / 1000)
+    user32.PostMessageW(hwnd, up, 0, pos)
+
+
