diff --git a/recomp/runtime/aot_dll.cpp b/recomp/runtime/aot_dll.cpp
index 571afa6..e959bd0 100644
--- a/recomp/runtime/aot_dll.cpp
+++ b/recomp/runtime/aot_dll.cpp
@@ -32,7 +32,15 @@ void unsupported(GuestContext *ctx, uint32_t pc) {
 
 } // namespace armrecomp
 
-extern "C" __declspec(dllexport) const armrecomp::AotModule *armrecomp_aot_init(const armrecomp::AotHost *host) {
+// the one exported symbol: a DLL export on Windows, a default-visibility ELF symbol elsewhere (Android .so, built
+// with hidden visibility so each module keeps its own runtime globals)
+#ifdef _WIN32
+#define ARMRECOMP_EXPORT __declspec(dllexport)
+#else
+#define ARMRECOMP_EXPORT __attribute__((visibility("default")))
+#endif
+
+extern "C" ARMRECOMP_EXPORT const armrecomp::AotModule *armrecomp_aot_init(const armrecomp::AotHost *host) {
     using namespace armrecomp;
     if (!host || host->abi_version != AOT_ABI_VERSION || host->context_size != sizeof(GuestContext))
         return nullptr;
diff --git a/recomp/runtime/armrecomp.h b/recomp/runtime/armrecomp.h
index 7e090a3..968e47f 100644
--- a/recomp/runtime/armrecomp.h
+++ b/recomp/runtime/armrecomp.h
@@ -79,7 +79,13 @@ void wr64(uint32_t a, uint64_t v);
 #ifndef RECOMP_CUSTOM_MEMORY
 template <typename T>
 inline bool cas(uint32_t a, T expected, T desired) {
+#if defined(__clang__) || defined(__GNUC__)
+    // the builtin, not std::atomic_ref: the Android NDK's libc++ (LLVM 18) has no atomic_ref
+    return __atomic_compare_exchange_n(reinterpret_cast<T *>(g_guest_base + a), &expected, desired, false,
+                                       __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+#else
     return std::atomic_ref<T>(*reinterpret_cast<T *>(g_guest_base + a)).compare_exchange_strong(expected, desired);
+#endif
 }
 #else
 template <typename T>
