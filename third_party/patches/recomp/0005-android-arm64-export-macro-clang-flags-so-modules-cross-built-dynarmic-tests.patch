diff --git a/recomp/CMakeLists.txt b/recomp/CMakeLists.txt
index d091af5..db63535 100644
--- a/recomp/CMakeLists.txt
+++ b/recomp/CMakeLists.txt
@@ -43,6 +43,10 @@ foreach(module IN LISTS RECOMP_MODULES)
     if(MSVC)
         # huge functions: /bigobj; keep optimisation moderate (compile time and memory)
         target_compile_options(gen_${module} PRIVATE /bigobj /O1 /w)
+    else()
+        # clang (Android NDK): the same moderate optimisation; position-independent for the shared module
+        target_compile_options(gen_${module} PRIVATE -O1 -g0 -w)
+        set_target_properties(gen_${module} PROPERTIES POSITION_INDEPENDENT_CODE ON CXX_VISIBILITY_PRESET hidden)
     endif()
     if(RECOMP_COUNT_INSNS)
         target_compile_definitions(gen_${module} PRIVATE RECOMP_COUNT_INSNS)
@@ -54,6 +58,12 @@ foreach(module IN LISTS RECOMP_MODULES)
     add_library(${RECOMP_DLL_PREFIX}${module} SHARED runtime/aot_dll.cpp)
     target_include_directories(${RECOMP_DLL_PREFIX}${module} PRIVATE runtime)
     target_link_libraries(${RECOMP_DLL_PREFIX}${module} PRIVATE gen_${module})
+    if(NOT WIN32)
+        # lib<prefix><module>.so: only armrecomp_aot_init is exported, so modules loaded side by side never
+        # share each other's runtime globals (g_guest_base, the host hooks)
+        set_target_properties(${RECOMP_DLL_PREFIX}${module} PROPERTIES CXX_VISIBILITY_PRESET hidden)
+        target_link_options(${RECOMP_DLL_PREFIX}${module} PRIVATE -Wl,--gc-sections -Wl,--no-undefined -Wl,--exclude-libs,ALL)
+    endif()
 endforeach()
 
