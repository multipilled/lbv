 #include <util/types.h>
 
 #include <atomic>
+#include <cstdio>
+#include <cstdlib>
 #include <memory>
 #include <mutex>
 #include <thread>
@@ -95,3 +97,17 @@ struct DisplayState {
 
     void deinit();
 };
+
+// VITA3K_TRACE_DISPLAY=<first vblank>,<last vblank>: between those vblanks (60 a second), log the display queue
+// entries, sceDisplaySetFrameBuf calls and the frames given to the presenter (debugging aid: frames that show the
+// wrong buffer)
+inline bool display_trace_on(const DisplayState &display) {
+    static const auto range = [] {
+        unsigned long long first = 0, last = 0;
+        if (const char *v = std::getenv("VITA3K_TRACE_DISPLAY"))
+            std::sscanf(v, "%llu,%llu", &first, &last);
+        return std::pair<uint64_t, uint64_t>(first, last);
+    }();
+    const uint64_t vblank = display.vblank_count.load(std::memory_order_relaxed);
+    return range.second && vblank >= range.first && vblank < range.second;
+}
