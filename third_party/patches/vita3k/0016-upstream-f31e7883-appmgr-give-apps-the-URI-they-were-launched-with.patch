diff --git a/vita3k/emuenv/include/emuenv/state.h b/vita3k/emuenv/include/emuenv/state.h
index 6e5ff7f2..1a04163d 100644
--- a/vita3k/emuenv/include/emuenv/state.h
+++ b/vita3k/emuenv/include/emuenv/state.h
@@ -116,6 +116,9 @@ private:
     std::unique_ptr<CompatState> _compat;
     mutable std::mutex _launch_request_mutex;
     std::optional<AppLaunchRequest> _pending_launch_request;
+    // The URI the running app was launched with, until sceAppMgrGetAppParam takes it
+    mutable std::mutex _launch_uri_mutex;
+    std::optional<std::string> _launch_uri;
 
 public:
     // App info contained in its `param.sfo` file
@@ -200,6 +203,22 @@ public:
         _pending_launch_request.reset();
     }
 
+    void set_launch_uri(std::string uri) {
+        std::scoped_lock lock(_launch_uri_mutex);
+        _launch_uri = std::move(uri);
+    }
+
+    // Returns the launch URI to the first caller only
+    std::optional<std::string> take_launch_uri() {
+        std::scoped_lock lock(_launch_uri_mutex);
+        return std::exchange(_launch_uri, std::nullopt);
+    }
+
+    void clear_launch_uri() {
+        std::scoped_lock lock(_launch_uri_mutex);
+        _launch_uri.reset();
+    }
+
     Root get_root_paths() const {
         Root r;
         r.set_vita_fs_path(vita_fs_path);
diff --git a/vita3k/interface.cpp b/vita3k/interface.cpp
index c89788cb..b493ae40 100644
--- a/vita3k/interface.cpp
+++ b/vita3k/interface.cpp
@@ -729,6 +729,9 @@ ExitCode run_app(EmuEnvState &emuenv, int32_t main_module_id, const AppLaunchReq
     }
     emuenv.main_thread_id = main_thread->id;
 
+    // Before any guest code runs, module_start functions included, since they can read it too
+    emuenv.set_launch_uri(emuenv.cfg.launch_uri);
+
     // Run `module_start` export (entry point) of loaded libraries
     for (auto &[_, module] : emuenv.kernel.loaded_modules) {
         if (module->info.modid != main_module_id)
diff --git a/vita3k/modules/SceAppMgr/SceAppMgr.cpp b/vita3k/modules/SceAppMgr/SceAppMgr.cpp
index 11770756..515edbf3 100644
--- a/vita3k/modules/SceAppMgr/SceAppMgr.cpp
+++ b/vita3k/modules/SceAppMgr/SceAppMgr.cpp
@@ -189,9 +189,22 @@ EXPORT(int, _sceAppMgrGetAppMgrState) {
     return UNIMPLEMENTED();
 }
 
-EXPORT(int, _sceAppMgrGetAppParam) {
-    TRACY_FUNC(_sceAppMgrGetAppParam);
-    return UNIMPLEMENTED();
+// The size sceAppMgrGetAppParam writes at most, without a terminator if the URI fills it
+constexpr size_t APP_PARAM_SIZE = 1024;
+
+EXPORT(SceInt32, _sceAppMgrGetAppParam, char *param) {
+    TRACY_FUNC(_sceAppMgrGetAppParam, param);
+    if (!param)
+        return RET_ERROR(SCE_APPMGR_ERROR_NULL_POINTER);
+
+    // Only the first call gets the launch URI, the ones after it get an empty string
+    const std::optional<std::string> uri = emuenv.take_launch_uri();
+    if (!uri) {
+        param[0] = '\0';
+        return SCE_APPMGR_ERROR_APP_PARAM_READ;
+    }
+    memcpy(param, uri->c_str(), std::min(uri->size() + 1, APP_PARAM_SIZE));
+    return 0;
 }
 
 EXPORT(int, _sceAppMgrGetAppParam2) {
