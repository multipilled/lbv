---
 vita3k/kernel/include/kernel/types.h          | 27 +++++++++++++++++++
 .../SceKernelThreadMgr/SceThreadmgr.cpp       |  8 +++---
 .../modules/SceKernelThreadMgr/SceThreadmgr.h | 10 +++++++
 vita3k/modules/SceLibKernel/SceLibKernel.cpp  | 14 +++++-----
 4 files changed, 49 insertions(+), 10 deletions(-)

diff --git a/vita3k/kernel/include/kernel/types.h b/vita3k/kernel/include/kernel/types.h
index e8e47483..77c9a449 100644
--- a/vita3k/kernel/include/kernel/types.h
+++ b/vita3k/kernel/include/kernel/types.h
@@ -67,6 +67,10 @@
 #define SCE_KERNEL_EVENT_CLOSE 0x00000200U
 // The bits of a simple event a game may set and clear, the others are system events
 #define SCE_KERNEL_EVENT_USER_DEFINED_MASK 0xFF000000U
+// Message pipe events: bytes were sent, bytes were received, the pipe holds data
+#define SCE_KERNEL_EVENT_IN 0x00000001U
+#define SCE_KERNEL_EVENT_OUT 0x00000002U
+#define SCE_KERNEL_EVENT_DATA_EXIST 0x00010000U
 
 #define SCE_KERNEL_ATTR_NOTIFY_CB_ALL 0x00000000U
 #define SCE_KERNEL_ATTR_NOTIFY_CB_WAKEUP_ONLY 0x00000800U
@@ -889,6 +893,29 @@ struct SceKernelEventInfo {
 };
 static_assert(sizeof(SceKernelEventInfo) == 0x40, "Incorrect size");
 
+// sceKernelWaitMultipleEvents modes: wait for any of the events, or for all of them
+#define SCE_KERNEL_EVENT_WAIT_MODE_OR 0x00000001U
+#define SCE_KERNEL_EVENT_WAIT_MODE_AND 0x00000002U
+// Maximum number of events in one sceKernelWaitMultipleEvents call
+#define SCE_KERNEL_MULTIPLE_EVENTS_MAX 64
+
+// One event passed to sceKernelWaitMultipleEvents and the bits to wait for
+struct SceKernelWaitEvent {
+    SceUID eventId;
+    SceUInt32 eventPattern;
+};
+static_assert(sizeof(SceKernelWaitEvent) == 0x8, "Incorrect size");
+
+// The result of one event in a sceKernelWaitMultipleEvents call
+struct SceKernelResultEvent {
+    SceUID eventId;
+    SceInt32 result;
+    SceUInt32 resultPattern;
+    SceInt32 reserved;
+    SceUInt64 userData;
+};
+static_assert(sizeof(SceKernelResultEvent) == 0x18, "Incorrect size");
+
 // What sceKernelGetTimerInfo reports
 struct SceKernelTimerInfo {
     SceSize size;
diff --git a/vita3k/modules/SceKernelThreadMgr/SceThreadmgr.cpp b/vita3k/modules/SceKernelThreadMgr/SceThreadmgr.cpp
index 2528f4d5..540237b7 100644
--- a/vita3k/modules/SceKernelThreadMgr/SceThreadmgr.cpp
+++ b/vita3k/modules/SceKernelThreadMgr/SceThreadmgr.cpp
@@ -1096,13 +1096,13 @@ EXPORT(SceInt32, _sceKernelWaitLwCondCB, Ptr<SceKernelLwCondWork> pWork, SceUInt
     return result;
 }
 
-EXPORT(int, _sceKernelWaitMultipleEvents) {
-    TRACY_FUNC(_sceKernelWaitMultipleEvents);
+EXPORT(SceInt32, _sceKernelWaitMultipleEvents, SceKernelWaitEvent *events, SceUInt32 count, SceUInt32 mode, SceKernelWaitMultipleEventsOpt *opt) {
+    TRACY_FUNC(_sceKernelWaitMultipleEvents, events, count, mode, opt);
     return UNIMPLEMENTED();
 }
 
-EXPORT(int, _sceKernelWaitMultipleEventsCB) {
-    TRACY_FUNC(_sceKernelWaitMultipleEventsCB);
+EXPORT(SceInt32, _sceKernelWaitMultipleEventsCB, SceKernelWaitEvent *events, SceUInt32 count, SceUInt32 mode, SceKernelWaitMultipleEventsOpt *opt) {
+    TRACY_FUNC(_sceKernelWaitMultipleEventsCB, events, count, mode, opt);
     return UNIMPLEMENTED();
 }
 
diff --git a/vita3k/modules/SceKernelThreadMgr/SceThreadmgr.h b/vita3k/modules/SceKernelThreadMgr/SceThreadmgr.h
index 964dc2d6..bfa3fc13 100644
--- a/vita3k/modules/SceKernelThreadMgr/SceThreadmgr.h
+++ b/vita3k/modules/SceKernelThreadMgr/SceThreadmgr.h
@@ -28,6 +28,16 @@ struct sceKernelRegisterThreadEventHandlerOpt {
     int reserved1;
 };
 
+// The result list and the timeout, packed in a struct by the user wrappers of
+// sceKernelWaitMultipleEvents
+struct SceKernelWaitMultipleEventsOpt {
+    Ptr<SceKernelResultEvent> results;
+    Ptr<SceUInt32> timeout;
+};
+
+DECL_EXPORT(SceInt32, _sceKernelWaitMultipleEvents, SceKernelWaitEvent *events, SceUInt32 count, SceUInt32 mode, SceKernelWaitMultipleEventsOpt *opt);
+DECL_EXPORT(SceInt32, _sceKernelWaitMultipleEventsCB, SceKernelWaitEvent *events, SceUInt32 count, SceUInt32 mode, SceKernelWaitMultipleEventsOpt *opt);
+
 DECL_EXPORT(SceUID, _sceKernelCreateCond, const char *pName, SceUInt32 attr, SceUID mutexId, const SceKernelCondOptParam *pOptParam);
 DECL_EXPORT(SceInt32, _sceKernelGetCondInfo, SceUID condId, Ptr<SceKernelCondInfo> pInfo);
 DECL_EXPORT(int, _sceKernelGetThreadExitStatus, SceUID thid, SceInt32 *pExitStatus);
diff --git a/vita3k/modules/SceLibKernel/SceLibKernel.cpp b/vita3k/modules/SceLibKernel/SceLibKernel.cpp
index 5710fa3d..87e37709 100644
--- a/vita3k/modules/SceLibKernel/SceLibKernel.cpp
+++ b/vita3k/modules/SceLibKernel/SceLibKernel.cpp
@@ -1993,14 +1993,16 @@ EXPORT(SceInt32, sceKernelWaitLwCondCB, Ptr<SceKernelLwCondWork> pWork, SceUInt3
     return CALL_EXPORT(_sceKernelWaitLwCondCB, pWork, pTimeout);
 }
 
-EXPORT(int, sceKernelWaitMultipleEvents) {
-    TRACY_FUNC(sceKernelWaitMultipleEvents);
-    return UNIMPLEMENTED();
+EXPORT(SceInt32, sceKernelWaitMultipleEvents, SceKernelWaitEvent *events, SceUInt32 count, SceUInt32 mode, Ptr<SceKernelResultEvent> results, Ptr<SceUInt32> timeout) {
+    TRACY_FUNC(sceKernelWaitMultipleEvents, events, count, mode, results, timeout);
+    SceKernelWaitMultipleEventsOpt opt{ results, timeout };
+    return CALL_EXPORT(_sceKernelWaitMultipleEvents, events, count, mode, &opt);
 }
 
-EXPORT(int, sceKernelWaitMultipleEventsCB) {
-    TRACY_FUNC(sceKernelWaitMultipleEventsCB);
-    return UNIMPLEMENTED();
+EXPORT(SceInt32, sceKernelWaitMultipleEventsCB, SceKernelWaitEvent *events, SceUInt32 count, SceUInt32 mode, Ptr<SceKernelResultEvent> results, Ptr<SceUInt32> timeout) {
+    TRACY_FUNC(sceKernelWaitMultipleEventsCB, events, count, mode, results, timeout);
+    SceKernelWaitMultipleEventsOpt opt{ results, timeout };
+    return CALL_EXPORT(_sceKernelWaitMultipleEventsCB, events, count, mode, &opt);
 }
 
