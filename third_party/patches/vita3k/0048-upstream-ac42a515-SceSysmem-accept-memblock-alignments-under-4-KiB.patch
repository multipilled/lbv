From 21b04ad94dd2efbbb23da84ed733c20e857d3ad7 Mon Sep 17 00:00:00 2001
From: nishinji <nishinji@users.noreply.github.com>
Date: Thu, 29 Oct 2026 19:13:21 +0900
Subject: [PATCH 48/52] SceSysmem: accept memblock alignments under 4 KiB

alignment_error rejected every PHYCONT alignment and CDRAM alignments
under 256 KiB. A Vita accepts 1 to 0x800 for both and only refuses
4 KiB and above (VitaAutotests memblock_alignment, PR #68).
Disgaea 3 allocates 70 MiB of CDRAM with alignment 16.
memblock_alignment now passes, so its expectation is pass.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
(cherry picked from commit ac42a515bcc0b84e698584c481e7e06088f7deff)
---
 vita3k/modules/SceSysmem/SceSysmem.cpp | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/vita3k/modules/SceSysmem/SceSysmem.cpp b/vita3k/modules/SceSysmem/SceSysmem.cpp
index c60caf04..a6533823 100644
--- a/vita3k/modules/SceSysmem/SceSysmem.cpp
+++ b/vita3k/modules/SceSysmem/SceSysmem.cpp
@@ -123,10 +123,13 @@ static SceInt32 alignment_error(SceKernelMemBlockType type, SceSize alignment) {
     if (alignment == 0)
         return 0;
     const SceUInt32 phymempart = type & MEMBLOCK_TYPE_PHYMEMPART_MASK;
-    if (phymempart == MEMBLOCK_TYPE_PHYMEMPART_PHYCONT || (alignment & (alignment - 1)) != 0)
+    if ((alignment & (alignment - 1)) != 0)
         return SCE_KERNEL_ERROR_INVALID_ARGUMENT;
+    // Under a page the alignment is below what every block has anyway
+    if (phymempart == MEMBLOCK_TYPE_PHYMEMPART_PHYCONT)
+        return alignment >= MEMBLOCK_MIN_ALIGNMENT ? SCE_KERNEL_ERROR_INVALID_ARGUMENT : 0;
     if (phymempart == MEMBLOCK_TYPE_PHYMEMPART_CDRAM) {
-        if (alignment < MEMBLOCK_CDRAM_MIN_ALIGNMENT)
+        if (alignment >= MEMBLOCK_MIN_ALIGNMENT && alignment < MEMBLOCK_CDRAM_MIN_ALIGNMENT)
             return SCE_KERNEL_ERROR_NO_FREE_PHYSICAL_PAGE_CDRAM;
         return alignment > MiB(64) ? SCE_KERNEL_ERROR_INVALID_ARGUMENT : 0;
     }
