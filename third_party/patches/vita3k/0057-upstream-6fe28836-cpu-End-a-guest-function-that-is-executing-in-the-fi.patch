---
 vita3k/cpu/src/dynarmic_cpu.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/vita3k/cpu/src/dynarmic_cpu.cpp b/vita3k/cpu/src/dynarmic_cpu.cpp
index 9e4b7606..fcbfcac5 100644
--- a/vita3k/cpu/src/dynarmic_cpu.cpp
+++ b/vita3k/cpu/src/dynarmic_cpu.cpp
@@ -168,6 +168,8 @@ public:
     std::optional<std::uint32_t> MemoryReadCode(Dynarmic::A32::VAddr addr) override {
         if (cpu->log_mem)
             LOG_TRACE("Instruction fetch at address 0x{:X}", addr);
+        if (addr < KiB(4))
+            return std::nullopt;
         return MemoryRead32(addr);
     }
 
@@ -339,6 +341,12 @@ public:
             cpu->jit->HaltExecution();
             break;
         }
+        case Dynarmic::A32::Exception::NoExecuteFault: {
+            LOG_CRITICAL("PC is 0x{:x}, stopping thread {}\n{}", pc, parent->thread_id, this->cpu->save_context().description());
+            cpu->halted = true;
+            cpu->jit->HaltExecution();
+            break;
+        }
         case Dynarmic::A32::Exception::PreloadDataWithIntentToWrite:
         case Dynarmic::A32::Exception::PreloadData:
         case Dynarmic::A32::Exception::PreloadInstruction:
