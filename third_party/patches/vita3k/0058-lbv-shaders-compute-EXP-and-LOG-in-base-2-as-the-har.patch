From 93511fe240b08917a51d2c828616526344dabb8a Mon Sep 17 00:00:00 2001
From: multipilled <336802225+multipilled@users.noreply.github.com>
Date: Sat, 31 Oct 2026 22:10:01 -0400
Subject: [PATCH 58/58] lbv: shaders compute EXP and LOG in base 2, as the
 hardware does

---
 vita3k/games/lbv/main.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/vita3k/games/lbv/main.cpp b/vita3k/games/lbv/main.cpp
index 29725f28..67274740 100644
--- a/vita3k/games/lbv/main.cpp
+++ b/vita3k/games/lbv/main.cpp
@@ -23,6 +23,8 @@
 
 #include "../../game-frontend/profile.h"
 
+#include <config/state.h>
+
 // provides WinMain for the windowed executable, which calls main below
 #include <SDL3/SDL_main.h>
 
@@ -59,5 +61,10 @@ int main(int argc, char *argv[]) {
     profile.name = "LittleBigPlanet";
     profile.id = "lbv";
     profile.ini = ini_layout();
+    profile.hooks.configure = [](game_frontend::Context &, Config &cfg) {
+        // exponents and logarithms in base 2, as the hardware computes them (shader/src/translator/alu.cpp)
+        // (M3c in the LBV docs, docs/formats/render-m3.md)
+        cfg.exp_log_base2 = true;
+    };
     return game_frontend::run(profile, argc, argv);
 }
