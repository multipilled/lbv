Date: Sat, 31 Oct 2026 23:56:38 -0400
Subject: [PATCH 61/62] lbv: save import/export (--import-save, --export-save,
 --quiet), touch help in lbv.ini

---
 vita3k/CMakeLists.txt      |  2 +-
 vita3k/games/lbv/main.cpp  | 52 ++++++++++++++++++--
 vita3k/games/lbv/saves.cpp | 97 ++++++++++++++++++++++++++++++++++++++
 vita3k/games/lbv/saves.h   | 40 ++++++++++++++++
 4 files changed, 187 insertions(+), 4 deletions(-)
 create mode 100644 vita3k/games/lbv/saves.cpp
 create mode 100644 vita3k/games/lbv/saves.h

diff --git a/vita3k/CMakeLists.txt b/vita3k/CMakeLists.txt
index 3fcdd57dd..40bddeb45 100644
--- a/vita3k/CMakeLists.txt
+++ b/vita3k/CMakeLists.txt
@@ -530,5 +530,5 @@ if(WIN32)
 	# Killzone Mercenary (PCSF00403)
 	add_game(vekta-mercenary games/vekta-mercenary/main.cpp)
 	# LittleBigPlanet PS Vita (PCSA00549), the LBV project
-	add_game(lbv games/lbv/main.cpp)
+	add_game(lbv games/lbv/main.cpp games/lbv/saves.cpp games/lbv/saves.h)
 endif()
diff --git a/vita3k/games/lbv/main.cpp b/vita3k/games/lbv/main.cpp
index 672747409..0141ae505 100644
--- a/vita3k/games/lbv/main.cpp
+++ b/vita3k/games/lbv/main.cpp
@@ -18,15 +18,17 @@
 // lbv.exe: LittleBigPlanet PS Vita (Marvel Super Hero Edition, NA, PCSA00549) on the shared
 // single-game frontend (game-frontend/profile.h). The LBV project's docs describe the port.
 //
-// Milestone M0 of that project: the game's profile and settings file only, so the game can be
-// installed, its modules written (--dump-elfs) and booted on the JIT. No game-specific fixes yet.
+// The game's profile, its settings file (lbv.ini), base-2 shader EXP/LOG (M3c) and save import/export (M4).
 
 #include "../../game-frontend/profile.h"
+#include "saves.h"
 
 #include <config/state.h>
+#include <util/log.h>
 
 // provides WinMain for the windowed executable, which calls main below
 #include <SDL3/SDL_main.h>
+#include <SDL3/SDL_messagebox.h>
 
 namespace {
 
@@ -48,14 +50,28 @@ game_frontend::IniLayout ini_layout() {
             layout::debug(id),
             layout::keyboard(),
             layout::gamepad(),
-            layout::touch("; None yet.\n"),
+            layout::touch("; The left mouse button touches the front screen and the right button the rear one, at the\n"
+                          "; pointer: LBP uses the front pad to pick and drag in the Popit and create mode, and the rear\n"
+                          "; pad to push some level objects out of the background.\n"
+                          "; No named touches by default.\n"),
         },
     };
 }
 
+// --import-save / --export-save
+struct SaveCommand {
+    std::string import_from, export_to;
+    bool quiet = false;
+};
+
 } // namespace
 
 int main(int argc, char *argv[]) {
+    // the game's own command line, besides the frontend's (game-frontend/frontend.cpp):
+    //   --import-save <folder> copy a save folder in (PCSA00017 or the folder above it), keeping the old one
+    //   --export-save <folder> copy the save folder out
+    //   --quiet                no message box for the two above (the result is in the log)
+    SaveCommand save;
     game_frontend::Profile profile;
     profile.title_id = TITLE_ID;
     profile.name = "LittleBigPlanet";
@@ -66,5 +82,35 @@ int main(int argc, char *argv[]) {
         // (M3c in the LBV docs, docs/formats/render-m3.md)
         cfg.exp_log_base2 = true;
     };
+    profile.hooks.parse_arg = [&](game_frontend::Context &, const std::vector<std::string> &args, size_t &i) {
+        const std::string &arg = args[i];
+        const bool has_value = i + 1 < args.size();
+        if (arg == "--import-save" && has_value)
+            save.import_from = args[++i];
+        else if (arg == "--export-save" && has_value)
+            save.export_to = args[++i];
+        else if (arg == "--quiet")
+            save.quiet = true;
+        else
+            return false;
+        return true;
+    };
+    profile.hooks.before_init = [&](game_frontend::Context &ctx) -> std::optional<int> {
+        if (save.import_from.empty() && save.export_to.empty())
+            return std::nullopt;
+        const auto &vita_fs = ctx.settings->vita_fs;
+        std::string message;
+        const bool ok = !save.import_from.empty()
+            ? lbv::import_save(vita_fs, fs_utils::utf8_to_path(save.import_from), ctx.data_dir / "save-backups", message)
+            : lbv::export_save(vita_fs, fs_utils::utf8_to_path(save.export_to), message);
+        if (ok)
+            LOG_INFO("Save: {}", message);
+        else
+            LOG_ERROR("Save: {}", message);
+        if (!save.quiet)
+            SDL_ShowSimpleMessageBox(ok ? SDL_MESSAGEBOX_INFORMATION : SDL_MESSAGEBOX_ERROR, ctx.window_name.c_str(),
+                ("Save: " + message).c_str(), nullptr);
+        return ok ? 0 : 1;
+    };
     return game_frontend::run(profile, argc, argv);
 }
diff --git a/vita3k/games/lbv/saves.cpp b/vita3k/games/lbv/saves.cpp
new file mode 100644
index 000000000..e0ef406a9
--- /dev/null
+++ b/vita3k/games/lbv/saves.cpp
@@ -0,0 +1,97 @@
