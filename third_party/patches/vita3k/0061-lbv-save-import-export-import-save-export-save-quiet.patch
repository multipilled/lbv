+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+#include "saves.h"
+
+#include <ctime>
+
+namespace lbv {
+
+namespace {
+
+constexpr const char *SAVE_ID = "PCSA00017";
+
+std::string timestamp() {
+    const std::time_t now = std::time(nullptr);
+    char text[32];
+    std::strftime(text, sizeof(text), "%Y-%m-%d_%H-%M-%S", std::localtime(&now));
+    return text;
+}
+
+// the folder under `source` that holds output/ (source itself, or source/PCSA00017)
+fs::path find_save(const fs::path &source) {
+    if (fs::is_directory(source / "output"))
+        return source;
+    if (fs::is_directory(source / SAVE_ID / "output"))
+        return source / SAVE_ID;
+    return {};
+}
+
+} // namespace
+
+fs::path save_dir(const fs::path &vita_fs) {
+    return vita_fs / "ux0" / "user" / "00" / "savedata" / SAVE_ID;
+}
+
+bool import_save(const fs::path &vita_fs, const fs::path &source, const fs::path &backup_dir, std::string &message) {
+    const fs::path from = find_save(source);
+    if (from.empty()) {
+        message = "no LittleBigPlanet save (a folder with output/) in " + source.string();
+        return false;
+    }
+    const fs::path dir = save_dir(vita_fs);
+    boost::system::error_code ec;
+    if (fs::exists(dir)) {
+        fs::path backup = backup_dir / timestamp();
+        for (int n = 2; fs::exists(backup); n++)
+            backup = backup_dir / (timestamp() + "_" + std::to_string(n));
+        fs::create_directories(backup, ec);
+        fs::copy(dir, backup / SAVE_ID, fs::copy_options::recursive, ec);
+        if (ec) {
+            message = "could not back up the save folder to " + backup.string() + ": " + ec.message();
+            return false;
+        }
+        fs::remove_all(dir, ec);
+    }
+    fs::create_directories(dir, ec);
+    fs::copy(from, dir, fs::copy_options::recursive | fs::copy_options::overwrite_existing, ec);
+    if (ec) {
+        message = "could not copy " + from.string() + ": " + ec.message();
+        return false;
+    }
+    message = "imported " + from.string() + " (the old save is in " + backup_dir.string() + ")";
+    return true;
+}
+
+bool export_save(const fs::path &vita_fs, const fs::path &dest, std::string &message) {
+    const fs::path dir = save_dir(vita_fs);
+    if (!fs::is_directory(dir / "output")) {
+        message = "no save yet (" + dir.string() + ")";
+        return false;
+    }
+    boost::system::error_code ec;
+    fs::create_directories(dest / SAVE_ID, ec);
+    fs::copy(dir, dest / SAVE_ID, fs::copy_options::recursive | fs::copy_options::overwrite_existing, ec);
+    if (ec) {
+        message = "could not copy to " + dest.string() + ": " + ec.message();
+        return false;
+    }
+    message = "exported to " + (dest / SAVE_ID).string();
+    return true;
+}
+
+} // namespace lbv
