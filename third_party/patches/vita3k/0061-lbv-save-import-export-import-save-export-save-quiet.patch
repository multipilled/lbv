+
+// LittleBigPlanet PS Vita's saves on the PC: ux0:user/00/savedata/PCSA00017/ in the Vita file system (the save
+// folder every LBP Vita edition shares, the Marvel edition PCSA00549 too) holds the game's own files (output/:
+// profile, levels, the progress) and Vita3K's slot records (SlotParam_<N>.bin). The folder is copied whole.
+#pragma once
+
+#include <util/fs.h>
+
+#include <string>
+
+namespace lbv {
+
+// The save folder in the Vita file system.
+fs::path save_dir(const fs::path &vita_fs);
+
+// Copies a save folder in (the folder that holds output/, or a folder above it, e.g. an export or a save decrypted
+// on a Vita). The save folder as it was goes to `backup_dir`/<date and time>/ first. Returns false with the reason
+// in `message`.
+bool import_save(const fs::path &vita_fs, const fs::path &source, const fs::path &backup_dir, std::string &message);
+
+// Copies the save folder to `dest` (dest/PCSA00017/...).
+bool export_save(const fs::path &vita_fs, const fs::path &dest, std::string &message);
+
+} // namespace lbv
